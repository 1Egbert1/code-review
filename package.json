{
  "name": "@yangleduo/ai-review",
  "version": "0.1.0",
  "description": "AI 代码审查：固定编排 + 三个审核员",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "acr": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
